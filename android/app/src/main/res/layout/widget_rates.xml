<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="#C9A227"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_row_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="#EDEFF3"
        android:textSize="14sp"
        android:text="USD/EUR  --" />

    <TextView
        android:id="@+id/widget_row_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="#EDEFF3"
        android:textSize="14sp"
        android:text="USD/GBP  --" />

    <TextView
        android:id="@+id/widget_row_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="#EDEFF3"
        android:textSize="14sp"
        android:text="USD/JPY  --" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#5C6885"
        android:textSize="9sp"
        android:text="Tap to load" />

</LinearLayout>
