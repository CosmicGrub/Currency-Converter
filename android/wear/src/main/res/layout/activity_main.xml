<?xml version="1.0" encoding="utf-8"?>
<!-- BoxInsetLayout (androidx.wear.widget) instead of a plain FrameLayout:
     the standard Wear OS jetpack widget for keeping content inside the
     round-screen safe area on a circular display like the Watch6
     Classic's, rather than hand-tuning padding per screen size. -->
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <!-- The rates list can now be longer than fits on screen (see
         RateFetcher's expanded QUICK_CODES) -- scrollable, and driven by
         the physical rotating bezel via MainActivity's rotary handling,
         not just touch/swipe. -->
    <ScrollView
        android:id="@+id/rates_scroll"
        app:layout_box="all"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/header_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXCHANGE BOARD"
                android:gravity="center"
                android:textColor="#C9A227"
                android:textSize="9sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <!-- Populated dynamically in MainActivity.render() -- one row
                 per RateFetcher.QUICK_CODES entry, so the row count isn't
                 hardcoded into the layout. -->
            <LinearLayout
                android:id="@+id/rates_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:gravity="center_horizontal" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#5C6885"
                android:textSize="8sp"
                android:text="Loading…" />

        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
