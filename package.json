{
  "name": "exchangeboard",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "description": "ExchangeBoard — a USD-based global currency converter with live, instant conversion.",
  "bin": {
    "exchangeboard": "./bin/exchangeboard.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "node scripts/link-eslint-typescript-compat.mjs && eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size-check": "node scripts/check-bundle-size.mjs",
    "postinstall": "node scripts/link-eslint-typescript-compat.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fast-check": "^4.9.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint-compat": "npm:typescript@6.0.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
